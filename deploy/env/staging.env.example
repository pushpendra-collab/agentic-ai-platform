# STAGING configuration template (Phase 7). PLACEHOLDERS ONLY.
#
# Staging runs the production image with APP_ENV=production, so it enforces exactly the
# production policy (OIDC only, no development tokens, PostgreSQL + Redis required).
# It differs from production only in WHICH resources it uses: its own database,
# Redis key prefix (or instance), identity-provider client/audience and LLM key.
# Never point staging at production data.

APP_ENV=production
APP_SECRETS_DIR=/run/secrets
LOG_LEVEL=INFO
LOG_FORMAT=json

LLM_MODEL=claude-opus-5-5
# SECRET: ANTHROPIC_API_KEY (a separate key/workspace from production)

AUTH_PROVIDER=oidc
AUTH_OIDC_ISSUER=https://<identity-provider>/<staging-issuer-path>
AUTH_OIDC_AUDIENCE=<staging API audience>
AUTH_OIDC_ROLE_MAP_JSON={"<external role or group>": ["member"]}
AUTH_OIDC_MAX_TOKEN_LIFETIME_SECONDS=900

# SECRET: DATABASE_URL=postgresql://agentic_app:<password>@<staging-host>:5432/agentic
# SECRET (migration job only): DATABASE_MIGRATION_URL=postgresql://agentic_owner:<password>@<staging-host>:5432/agentic
DATABASE_SSL_MODE=verify-full

# SECRET: REDIS_URL=rediss://:<password>@<staging-host>:6380/0
REDIS_KEY_PREFIX=agentic-staging

# Interactive docs may be enabled in staging (they are unauthenticated).
API_DOCS_ENABLED=true
API_RUN_MAINTENANCE=false

# Phase 8: same gateway and rate-limit settings as production (deploy/env/production.env.example).
API_FORWARDED_ALLOW_IPS=<gateway address or private CIDR>
RATE_LIMIT_ENABLED=true
