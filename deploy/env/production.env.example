# PRODUCTION configuration template (Phase 7). PLACEHOLDERS ONLY: never put a real value
# in this file or in any file in the repository.
#
# Non-secret values below go into the deployment configuration (orchestrator manifest,
# environment of the container). Values marked SECRET come from the secret manager,
# either as environment variables or as files under APP_SECRETS_DIR (one file per
# variable, named exactly like it). Check before deploying:
#
#   docker run --rm --env-file <rendered file> agentic-platform:<tag> \
#       python -m agentic_platform.api --check-config        # exit 1 = refused
#
# The API and the worker refuse to start in production while that report has errors.

APP_ENV=production
APP_SECRETS_DIR=/run/secrets
# DEBUG is refused in production (Phase 15). Logs are JSON lines on stderr: the platform's
# log collector ships them (deployment target: Q3).
LOG_LEVEL=INFO
LOG_FORMAT=json
# Phase 15 (ADR-064): metrics/tracing exporter. DEPLOYMENT TARGET REQUIRED (Q3): until it is
# chosen only `none` exists (metrics and traces stay in-process; events are in the logs).
OBSERVABILITY_EXPORTER=none
OBSERVABILITY_FLUSH_TIMEOUT_SECONDS=5

# --- LLM (API only) -----------------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_ANTHROPIC_FALLBACKS=default
# SECRET: ANTHROPIC_API_KEY (or workload identity federation: ANTHROPIC_FEDERATION_RULE_ID,
# ANTHROPIC_ORGANIZATION_ID, ANTHROPIC_SERVICE_ACCOUNT_ID, ANTHROPIC_IDENTITY_TOKEN_FILE)
# ANTHROPIC_API_KEY=<from secret manager>
# LLM_ANTHROPIC_BASE_URL=https://<egress-gateway>   # only if traffic must go through one

# --- Identity provider (API only; provider not chosen yet: PROJECT_STATUS Q6) --------------
AUTH_PROVIDER=oidc
AUTH_OIDC_ISSUER=https://<identity-provider>/<issuer-path>
AUTH_OIDC_AUDIENCE=<this API's audience / resource identifier>
# AUTH_OIDC_JWKS_URL=        # empty = discovered from the issuer
AUTH_OIDC_ALGORITHMS=["RS256"]
AUTH_OIDC_USER_CLAIM=sub
AUTH_OIDC_TENANT_CLAIM=tenant_id
AUTH_OIDC_ROLES_CLAIM=roles
AUTH_OIDC_ROLE_MAP_JSON={"<external role or group>": ["member"]}
AUTH_OIDC_MAX_TOKEN_LIFETIME_SECONDS=900
AUTH_OIDC_LEEWAY_SECONDS=30
# Never set in production: AUTH_TOKEN_SECRET, AUTH_ALLOW_LOCAL_IDENTITY=true.

# --- PostgreSQL (managed service with pgvector) --------------------------------------------
# SECRET: DATABASE_URL=postgresql://agentic_app:<password>@<host>:5432/agentic
#   runtime role only (DML, RLS); the schema-owner URL goes to the migration job only:
# SECRET (migration job only): DATABASE_MIGRATION_URL=postgresql://agentic_owner:<password>@<host>:5432/agentic
DATABASE_SSL_MODE=verify-full
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Phase 8: client-side bound per command (above the statement timeout).
DATABASE_COMMAND_TIMEOUT_SECONDS=20
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_ECHO_SQL=false

# --- Redis (managed, TLS, password/ACL) ----------------------------------------------------
# SECRET: REDIS_URL=rediss://:<password>@<host>:6380/0
REDIS_KEY_PREFIX=agentic-prod

# --- Memory ---------------------------------------------------------------------------------
MEMORY_ENABLED=true
# hashing = lexical; a production embedding provider is open question Q14.
MEMORY_EMBEDDING_PROVIDER=hashing
MEMORY_AGENT_FACT_WRITES=off

# --- API process ----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_DOCS_ENABLED=false
API_RUN_MAINTENANCE=false
# Shutdown (Phase 15): in-flight requests may finish for API_GRACEFUL_SHUTDOWN_SECONDS, then
# cleanup takes at most API_SHUTDOWN_CLEANUP_SECONDS. Set the orchestrator's termination
# grace period above the sum (e.g. 30 + 10 + 5 = 45 s).
API_GRACEFUL_SHUTDOWN_SECONDS=30
API_SHUTDOWN_CLEANUP_SECONDS=10
# Phase 15: concurrent agent turns per API process (503 SERVER_BUSY beyond). A protection
# bound, NOT a capacity figure: size it from a load test on the real deployment (Q3).
API_MAX_CONCURRENT_TURNS=32
API_MAX_BODY_BYTES=1048576
# Phase 8 (ADR-054): the gateway in front of the API (deploy/gateway). uvicorn applies
# X-Forwarded-For/-Proto only from these addresses (IPs or CIDRs, comma-separated). Never "*".
API_PROXY_HEADERS=true
API_FORWARDED_ALLOW_IPS=<gateway address or private CIDR, e.g. 10.0.0.0/24>

# --- Rate limits (Phase 8, ADR-053) ---------------------------------------------------------
# Per verified caller (tenant + user), counted in Redis, shared by every API replica.
# PROVISIONAL technical defaults, not business decisions (PROJECT_STATUS Q20). 0 = class off.
# Unauthenticated traffic is limited per client address at the gateway instead.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_TURNS_PER_WINDOW=20
RATE_LIMIT_APPROVAL_DECISIONS_PER_WINDOW=60
RATE_LIMIT_WRITES_PER_WINDOW=60
RATE_LIMIT_READS_PER_WINDOW=600
RATE_LIMIT_FAIL_OPEN=true

# --- Maintenance worker ---------------------------------------------------------------------
MAINTENANCE_BATCH_SIZE=500
MAINTENANCE_MAX_BATCHES=200
MAINTENANCE_INTERVAL_SECONDS=3600
MAINTENANCE_JOB_LOCK_TTL_SECONDS=300

# --- Approvals ------------------------------------------------------------------------------
APPROVAL_TTL_SECONDS=86400
APPROVAL_MIN_RISK=high

# --- ERP business reads (Phase 10, ADR-059) ----------------------------------------------------
# Read only, always. Stays `none` until the ERP access contract and a verified schema mapping
# exist (PROJECT_STATUS Q1). `fake` is refused in production. For `postgres`: the URL of the
# ERP's READ-ONLY role goes in a secret file (ERP_DATABASE_URL), never here.
ERP_ADAPTER=none
# ERP_EXPECTED_DATABASE=<agreed with the ERP owner>
# ERP_SSL_MODE=verify-full
# ERP_STATEMENT_TIMEOUT_MS=8000
# ERP_QUERY_TIMEOUT_SECONDS=8
# ERP_MAX_ROWS=200
# ERP_BUSINESS_TIMEZONE=<the business day's IANA time zone, confirmed by the ERP owner>
