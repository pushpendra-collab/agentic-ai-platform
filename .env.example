# DEVELOPMENT configuration. Copy to .env and adjust. Never commit .env.
# Real environment variables take precedence over values in .env.
#
# Other environments (Phase 7): deploy/env/staging.env.example and
# deploy/env/production.env.example list what those need (placeholders only).
# Production secrets never live in a file in the repository: they come from the
# platform's secret manager as environment variables or as secret files.
#
# Secret files: when APP_SECRETS_DIR names a directory, any setting below can be read
# from a file there named like the variable (e.g. /run/secrets/DATABASE_URL).
# Precedence: environment variable > .env > secret file.
APP_SECRETS_DIR=

# --- Application -----------------------------------------------------------
# development | test | production
APP_ENV=development

# --- Logging ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json

# --- Observability (Phase 13, ADR-062) -------------------------------------
# One JSON log line per observability event (turn/stage/tool/LLM/checkpoint/retry/timeout).
# Events hold ids, codes, counts and durations only. Metrics and the diagnostic trace
# buffer are kept either way.
OBSERVABILITY_LOG_EVENTS=true
# Recent requests whose events are kept in memory for Agent.diagnose / --trace (0 = none).
OBSERVABILITY_TRACE_BUFFER_REQUESTS=200
# Phase 15 (ADR-064): metrics/tracing exporter. Only `none` exists until the deployment
# target is chosen (Q3); other values are refused at startup. Logs need no exporter.
OBSERVABILITY_EXPORTER=none
# Shutdown: how long exporters may take to flush.
OBSERVABILITY_FLUSH_TIMEOUT_SECONDS=5

# --- LLM provider ----------------------------------------------------------
# anthropic | ollama (local models, see the Ollama block below)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_MAX_TOKENS=16000
# low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_TIMEOUT_SECONDS=120
# SDK-level retries for 408/409/429/5xx/connection errors.
LLM_MAX_RETRIES=2
# Server-side refusal fallback: default | off
LLM_ANTHROPIC_FALLBACKS=default
# Optional endpoint override (egress gateway / proxy). Empty = SDK default. https in production.
LLM_ANTHROPIC_BASE_URL=

# Credentials. Optional if you used `ant auth login` or set ANTHROPIC_AUTH_TOKEN;
# the Anthropic SDK resolves those automatically.
ANTHROPIC_API_KEY=

# Ollama (LLM_PROVIDER=ollama, LLM_MODEL=<a pulled model, e.g. qwen3:8b>). No credential.
# On CPU-only machines raise LLM_TIMEOUT_SECONDS (a planner call can take minutes).
# LLM_EFFORT does not apply to Ollama; LLM_OLLAMA_THINK=true turns on thinking (slower).
LLM_OLLAMA_BASE_URL=http://localhost:11434
# Context window per request; longer prompts are silently truncated by Ollama.
LLM_OLLAMA_NUM_CTX=16384
LLM_OLLAMA_THINK=false
# How long Ollama keeps the model loaded after a request (5m, 1h, -1 = always).
LLM_OLLAMA_KEEP_ALIVE=10m

# --- Agent runtime ---------------------------------------------------------
AGENT_RECURSION_LIMIT=25
AGENT_MAX_TOOL_CALLS_PER_TURN=5
AGENT_MAX_INPUT_CHARS=8000
AGENT_MAX_HISTORY_MESSAGES=20
# One turn at a time per conversation (distributed lock; Redis when configured).
AGENT_THREAD_LOCK_TTL_SECONDS=30
AGENT_THREAD_LOCK_WAIT_SECONDS=2
# Deadline for one domain handler run (Phase 12): its planned tool calls together.
AGENT_DOMAIN_TIMEOUT_SECONDS=120
# Where conversation state is kept: auto | postgres | memory | none
# auto = postgres when DATABASE_URL is set (durable; run `alembic upgrade head`),
# otherwise memory (lost when the process exits).
AGENT_CHECKPOINTER=auto

# --- PostgreSQL ------------------------------------------------------------
# Runtime connection: least-privilege application role (DML only, no DDL).
# Leave unset to run the agent without a database (database tools disabled).
# Only PostgreSQL is accepted; postgres:// and postgresql:// are converted to
# the asyncpg driver automatically.
DATABASE_URL=postgresql://agentic_app:agentic_app_dev@localhost:5432/agentic
# Schema-owner connection used only by `alembic`. Falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=postgresql://agentic_owner:agentic_owner_dev@localhost:5432/agentic
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_PRE_PING=true
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Phase 8: client-side bound per command (above the statement timeout).
DATABASE_COMMAND_TIMEOUT_SECONDS=20
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# disable | prefer | require | verify-ca | verify-full  (unset = driver default)
DATABASE_SSL_MODE=
DATABASE_APPLICATION_NAME=agentic_platform
DATABASE_HEALTH_TIMEOUT_SECONDS=3
DATABASE_ECHO_SQL=false

# --- Redis -----------------------------------------------------------------
# Ephemeral, rebuildable data only: cache, temporary state, distributed locks,
# idempotency fast-path. PostgreSQL stays the source of truth.
# Leave unset to use process-local fallbacks (single process only).
# redis:// or rediss:// (TLS). Format: redis://:password@host:6379/db
REDIS_URL=redis://:agentic_redis_dev@localhost:6379/0
# Every key starts with "<prefix>:" (share one server between environments safely).
REDIS_KEY_PREFIX=agentic
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_HEALTH_TIMEOUT_SECONDS=2
REDIS_CACHE_DEFAULT_TTL_SECONDS=300
REDIS_TEMPORARY_STATE_TTL_SECONDS=3600
REDIS_IDEMPOTENCY_CACHE_TTL_SECONDS=3600
REDIS_CLIENT_NAME=agentic_platform

# --- Agent memory (Phase 4) ----------------------------------------------------
MEMORY_ENABLED=true
# Tenant and user of the LOCAL DEVELOPMENT identity (Phase 5: used only when no
# authenticated principal is given and local identity is allowed; see AUTH_*).
MEMORY_DEFAULT_TENANT_ID=default
MEMORY_DEFAULT_USER_ID=local
# hashing = local, deterministic, LEXICAL (dev/tests); voyage = semantic (Voyage AI).
MEMORY_EMBEDDING_PROVIDER=hashing
# Provider default when empty (voyage: voyage-3.5). Changing it requires re-ingesting.
MEMORY_EMBEDDING_MODEL=
MEMORY_EMBEDDING_DIMENSIONS=256
MEMORY_EMBEDDING_TIMEOUT_SECONDS=30
VOYAGE_API_KEY=
MEMORY_RECALL_K=5
MEMORY_RECALL_MIN_SCORE=0.2
MEMORY_RECALL_TIMEOUT_SECONDS=5
MEMORY_CONTEXT_MAX_CHARS=4000
MEMORY_RECORD_EPISODES=true
MEMORY_EPISODIC_RETENTION_DAYS=90
MEMORY_WORKING_TTL_SECONDS=3600
MEMORY_MAX_CONTENT_CHARS=20000
MEMORY_CHUNK_CHARS=1200
MEMORY_CHUNK_OVERLAP_CHARS=150
# May the agent propose long-term facts? off (default) | approval (every write waits
# for the user's explicit approval: memory.remember_fact tool + HITL).
MEMORY_AGENT_FACT_WRITES=off

# --- Identity and permissions (Phase 5) -----------------------------------------
# No identity provider yet. Development tokens are HMAC-signed with this secret
# (>= 32 chars). Leave empty to disable token sign-in. Never commit a real secret.
AUTH_TOKEN_SECRET=
AUTH_TOKEN_ISSUER=agentic-platform-dev
AUTH_TOKEN_MAX_TTL_SECONDS=43200
# Local development identity (CLI flags / no principal): empty = allowed unless
# APP_ENV=production. Set false to require tokens everywhere.
AUTH_ALLOW_LOCAL_IDENTITY=
# Roles of the local identity (JSON list).
AUTH_LOCAL_ROLES=["member"]
# Optional JSON object replacing the built-in role catalogue, e.g.
# {"member": ["conversation.read", "conversation.write"], "approver": ["approval.decide"]}
AUTH_ROLE_CATALOG_JSON=

# --- HTTP authentication / identity provider (Phase 6) --------------------------
# Which bearer tokens the HTTP API accepts: dev_token | oidc.
# Empty = dev_token when AUTH_TOKEN_SECRET is set outside production. Production
# must use oidc: the API refuses to start with development tokens there.
AUTH_PROVIDER=
# Optional `aud` of development tokens (issued with it, required when verifying).
AUTH_TOKEN_AUDIENCE=
# OIDC / OAuth2 provider issuing signed JWT access tokens (AUTH_PROVIDER=oidc).
# Needs: pip install -e ".[oidc]". No provider has been chosen yet (open question Q6).
AUTH_OIDC_ISSUER=
AUTH_OIDC_AUDIENCE=
# Empty = discovered from <issuer>/.well-known/openid-configuration. https in production.
AUTH_OIDC_JWKS_URL=
# Asymmetric algorithms only (RS*, PS*, ES256/384); HS* and "none" are refused.
AUTH_OIDC_ALGORITHMS=["RS256"]
# Claim names (provider-specific).
AUTH_OIDC_USER_CLAIM=sub
AUTH_OIDC_TENANT_CLAIM=tenant_id
AUTH_OIDC_ROLES_CLAIM=roles
# Optional {"<external role or group>": ["<platform role>", ...]}. Empty = external
# names that match a platform role are used as-is. Tokens never carry permissions.
AUTH_OIDC_ROLE_MAP_JSON=
AUTH_OIDC_JWKS_CACHE_SECONDS=600
AUTH_OIDC_HTTP_TIMEOUT_SECONDS=5
AUTH_OIDC_LEEWAY_SECONDS=30
# Longest accepted access-token lifetime (exp - iat). Empty = whatever the provider
# issues. Bounds how long a token outlives a disabled user (no revocation for JWTs).
# Recommended in production: the provider's access-token lifetime, at most 900.
AUTH_OIDC_MAX_TOKEN_LIFETIME_SECONDS=

# --- HTTP API (Phase 6) ----------------------------------------------------------
# python -m agentic_platform.api
API_HOST=127.0.0.1
API_PORT=8000
# /docs and /openapi.json. Empty = on unless APP_ENV=production.
API_DOCS_ENABLED=
# Larger request bodies are refused with 413.
API_MAX_BODY_BYTES=1048576
# Run the maintenance scheduler inside the API process (single-process development
# only). Production: run `python -m agentic_platform.maintenance` separately.
API_RUN_MAINTENANCE=false
# SIGTERM: seconds in-flight requests may finish before the server closes them.
API_GRACEFUL_SHUTDOWN_SECONDS=30
# Phase 15 (ADR-064): then, at most this long to let cancelled requests unwind and to close
# Redis, PostgreSQL and ERP pools (each step bounded). Orchestrator grace period must exceed
# API_GRACEFUL_SHUTDOWN_SECONDS + API_SHUTDOWN_CLEANUP_SECONDS.
API_SHUTDOWN_CLEANUP_SECONDS=10
# Phase 15: agent turns running at once in one API process; one more gets 503 SERVER_BUSY
# (retryable). 0 = unlimited. A protection bound, not a capacity figure.
API_MAX_CONCURRENT_TURNS=32
# Phase 8: apply X-Forwarded-For/-Proto only from these proxies (IPs/CIDRs). Never "*".
API_PROXY_HEADERS=true
API_FORWARDED_ALLOW_IPS=127.0.0.1

# --- Rate limits (Phase 8, ADR-053) -------------------------------------------------
# Per verified caller (tenant + user), fixed windows counted in Redis. Empty ENABLED =
# on in production, off elsewhere. Provisional defaults (PROJECT_STATUS Q20); 0 = class off.
RATE_LIMIT_ENABLED=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_TURNS_PER_WINDOW=20
RATE_LIMIT_APPROVAL_DECISIONS_PER_WINDOW=60
RATE_LIMIT_WRITES_PER_WINDOW=60
RATE_LIMIT_READS_PER_WINDOW=600
# Redis down: true = allow and log ratelimit.unavailable; false = 503.
RATE_LIMIT_FAIL_OPEN=true

# --- Scheduled maintenance (Phase 6) ----------------------------------------------
# python -m agentic_platform.maintenance [--loop]. Applies existing expiry only;
# no retention period is configured here.
MAINTENANCE_BATCH_SIZE=500
MAINTENANCE_MAX_BATCHES=200
MAINTENANCE_INTERVAL_SECONDS=3600
MAINTENANCE_JOB_LOCK_TTL_SECONDS=300

# --- Human-in-the-loop approvals (Phase 5) --------------------------------------
# How long a pending approval stays valid.
APPROVAL_TTL_SECONDS=86400
# Read tools at or above this risk also need approval: low | medium | high | never.
# Write tools always need approval.
APPROVAL_MIN_RISK=high

# docker-compose.yml (local development only)
POSTGRES_OWNER_PASSWORD=agentic_owner_dev
POSTGRES_APP_PASSWORD=agentic_app_dev
POSTGRES_PORT=5432
REDIS_PASSWORD=agentic_redis_dev
REDIS_PORT=6379
# docker compose --profile app: API host port.
# docker compose --profile idp-test: reference Keycloak (verification only, not production).
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_PASSWORD=keycloak_admin_dev
# docker compose --profile gateway (Phase 8): TLS gateway; needs deploy/gateway/dev-certs.sh.
GATEWAY_HTTPS_PORT=8443
GATEWAY_HTTP_PORT=8081
GATEWAY_REQUESTS_PER_SECOND=20
GATEWAY_BURST=40
GATEWAY_TURNS_PER_MINUTE=30
GATEWAY_MAX_CONNECTIONS_PER_IP=20
GATEWAY_TURN_TIMEOUT_SECONDS=300
# Migration job only (Phase 8): 1 = allow migrating a non-empty database that has no
# alembic_version table. Never set it for an ERP / system-of-record database.
AGENTIC_MIGRATE_NON_EMPTY_DATABASE=

# Integration tests (tests/integration). Unset = those tests are skipped.
# Tests do NOT read .env: export these in the shell that runs pytest.
TEST_DATABASE_URL=postgresql://agentic_owner:agentic_owner_dev@localhost:5432/agentic_test
TEST_DATABASE_APP_URL=postgresql://agentic_app:agentic_app_dev@localhost:5432/agentic_test
# Redis integration tests use database 15 and the key prefix "agentic-test".
TEST_REDIS_URL=redis://:agentic_redis_dev@localhost:6379/15

# Live verification (tests/live). Unset = skipped. Never put real keys in this file.
# RUN_LIVE_LLM_TESTS=1 makes real (billed) LLM requests; needs ANTHROPIC_API_KEY.
RUN_LIVE_LLM_TESTS=
LIVE_KEYCLOAK_URL=
LIVE_KEYCLOAK_ADMIN_PASSWORD=
# A provider candidate (Q6): issuer, this API's audience, and one access token from it.
LIVE_OIDC_ISSUER=
LIVE_OIDC_AUDIENCE=
LIVE_OIDC_ACCESS_TOKEN=

# --- ERP business reads (Phase 10, ADR-059; InvenLogic 2026-10-30) -----------------------
# none (default): business questions are `unsupported`.
# postgres: the read-only ERP boundary. A capability answers only when the contract
#       (ERP_CONTRACT_PATH) maps it VERIFIED and names its reader set; InvenLogic:
#       docs/erp/invenlogic_contract.json + docs/erp/INVENLOGIC_MAPPING.md.
# (The fake TEST-data adapter was removed on 2026-10-30.)
# Grant the business permissions through AUTH_ROLE_CATALOG_JSON, e.g.
#       {"member": [...], "sales_viewer": ["business.customer.read", "business.sales.read"],
#        "stock_viewer": ["business.inventory.read", "business.warehouse.all"]}
# The platform tenant id must be the InvenLogic company id (digits).
ERP_ADAPTER=none
# Single-database ERP: ERP_DATABASE_URL + ERP_EXPECTED_DATABASE.
ERP_DATABASE_URL=
ERP_EXPECTED_DATABASE=
# Multi-database ERP (InvenLogic: one database per service): JSON of contract database
# key -> read-only URL, from the secret store. Use an IP or a host that resolves to the
# address Postgres listens on (on Windows "localhost" may try IPv6 first and stall).
#   ERP_DATABASE_URLS={"master_data":"postgresql://reader:<pw>@10.0.0.5:5432/master_data_db",
#                      "sales":"postgresql://reader:<pw>@10.0.0.5:5432/sales_db",
#                      "inventory":"postgresql://reader:<pw>@10.0.0.5:5432/inventory_db"}
ERP_DATABASE_URLS=
ERP_SSL_MODE=
ERP_BUSINESS_TIMEZONE=
# Phase 13: attempts per business read when the ERP is unreachable (ERP_UNAVAILABLE only;
# never timeouts or data errors). All attempts share ERP_QUERY_TIMEOUT_SECONDS. 1 = no retry.
ERP_READ_MAX_ATTEMPTS=2
# Phase 14 (ADR-063): the ERP access contract confirmed by the ERP owner (JSON, no secrets;
# docs/erp/ERP_CONTRACT.md). Required for ERP_ADAPTER=postgres in production. Without it the
# live adapter runs no business read. Check it with: python -m scripts.erp_readiness --contract <path>
ERP_CONTRACT_PATH=
ERP_READ_RETRY_BACKOFF_SECONDS=0.1
